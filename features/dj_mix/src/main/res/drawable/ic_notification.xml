<!--
  res/drawable/ic_notification.xml
  ─────────────────────────────────
  Drop this file directly into your project at:
      app/src/main/res/drawable/ic_notification.xml

  Then in NewAudioScanWorker.kt and MixOfTheDayWorker.kt replace:
      val iconResId = android.R.drawable.stat_sys_headset
  with:
      val iconResId = R.drawable.ic_notification

  Android auto-tints notification small icons to match the system theme
  (white on dark bars, dark on light bars) — this works because the
  drawable is flat single-color with a transparent background.
-->
